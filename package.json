{
  "name": "@astilba/platform",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "check": "make check && pnpm --filter @astilba/cloudflare-spike check && pnpm --filter @astilba/canvas-spike check",
    "verify": "pnpm check && make verify && pnpm --filter @astilba/cloudflare-spike verify",
    "generate": "node scripts/platform-generate.mjs",
    "generate:check": "node scripts/platform-generate.mjs --check",
    "app:build": "node scripts/platform-build.mjs",
    "app:notices": "node scripts/platform-notices.mjs",
    "app:source": "node scripts/platform-source.mjs",
    "app:image-test": "node scripts/platform-image-test.mjs",
    "app:fixture": "node scripts/platform-fixture.mjs",
    "agent:build": "node scripts/platform-agent-build.mjs",
    "lint": "vp lint --deny-warnings apps/platform experiments/canvas-editor vite.config.ts",
    "format": "vp fmt --write apps/platform experiments/canvas-editor vite.config.ts",
    "format:check": "vp fmt --check apps/platform experiments/canvas-editor vite.config.ts"
  },
  "devDependencies": {
    "vite-plus": "1.4.0"
  }
}
