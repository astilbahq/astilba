{
  "name": "astilba",
  "version": "0.0.0",
  "private": true,
  "description": "Astilba's development monorepo for Env, UI, web applications and unreleased Cache.",
  "homepage": "https://github.com/astilbahq/astilba#readme",
  "bugs": {
    "url": "https://github.com/astilbahq/astilba/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astilbahq/astilba.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @astilba/tokens build && pnpm --filter @astilba/ui build && pnpm --filter @astilba/showcase build && pnpm --filter @astilba/integration-astro build",
    "check": "oxfmt --config oxfmt.config.ts --disable-nested-config --check . && oxlint --config oxlint.config.ts --disable-nested-config .",
    "deploy:dry-run": "pnpm --filter @astilba/showcase build && wrangler deploy --dry-run",
    "dev": "pnpm --filter @astilba/tokens build && pnpm --filter @astilba/ui build && pnpm --filter @astilba/showcase dev",
    "fix": "oxfmt --config oxfmt.config.ts --disable-nested-config --write . && oxlint --config oxlint.config.ts --disable-nested-config --fix .",
    "knip": "knip --workspace . --workspace packages/tokens --workspace packages/ui --workspace apps/ui-showcase --workspace fixtures/ui-astro",
    "pack:check": "pnpm --filter @astilba/tokens pack:check && pnpm --filter @astilba/ui pack:check",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "pnpm test:dependency-security && pnpm --filter @astilba/tokens --filter @astilba/ui --filter @astilba/showcase --filter @astilba/integration-astro --recursive test",
    "test:astro": "pnpm --filter @astilba/tokens build && pnpm --filter @astilba/ui build && pnpm --filter @astilba/integration-astro test",
    "test:browser": "pnpm build && pnpm test:browser:run",
    "test:browser:install": "playwright install chromium",
    "test:browser:install:ci": "playwright install --with-deps chromium",
    "test:browser:run": "playwright test",
    "test:browser:update": "pnpm build && playwright test --update-snapshots",
    "typecheck": "pnpm --filter @astilba/tokens --filter @astilba/ui --filter @astilba/showcase --filter @astilba/integration-astro --recursive typecheck",
    "verify": "pnpm verify:boundaries && pnpm verify:ui && pnpm verify:env && pnpm verify:web && pnpm verify:cache",
    "verify:cache": "pnpm --dir products/cache verify",
    "verify:boundaries": "node --test tooling/migration/pilot-boundaries.test.mjs",
    "verify:ui": "pnpm verify:base && pnpm test:browser && pnpm deploy:dry-run",
    "verify:env": "pnpm --dir packages/env check && pnpm verify:registry:lint && pnpm --dir packages/env knip && pnpm --dir packages/env verify",
    "verify:registry:lint": "node tooling/migration/check-registry.mjs",
    "verify:env:archive": "pnpm --dir packages/env pack:artifact && pnpm --dir packages/env verify:artifact",
    "verify:env:consumers": "node tooling/migration/verify-env-consumers.mjs",
    "verify:registry": "corepack pnpm@11.10.0 --dir fixtures/registry/env verify:all",
    "verify:web": "pnpm --dir apps/docs verify",
    "verify:base": "pnpm check && pnpm typecheck && pnpm test && pnpm knip && pnpm pack:check",
    "verify:release-version": "tsx scripts/verify-release-version.ts",
    "test:dependency-security": "node --test scripts/dependency-security.test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.3",
    "knip": "6.29.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "publint": "0.3.21",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "ultracite": "7.9.4",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.114.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0",
    "pnpm": ">=11.10.0"
  },
  "packageManager": "pnpm@11.17.0"
}
