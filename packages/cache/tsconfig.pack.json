{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node"],
    "skipLibCheck": true,
    "declaration": true,
    "isolatedDeclarations": false,
    "noEmit": false
  },
  "include": [
    "src/index.ts",
    "src/adapters/cloudflare/**/*.ts",
    "src/adapters/react-router/**/*.ts",
    "test/integration/worker-configuration.d.ts"
  ]
}
