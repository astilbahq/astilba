{
  "name": "@astilba/tokens",
  "version": "0.6.0",
  "private": true,
  "description": "Astilba's framework-neutral design tokens and Panda preset.",
  "homepage": "https://github.com/astilbahq/astilba/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/astilbahq/astilba/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astilbahq/astilba.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./panda": {
      "types": "./dist/panda.d.ts",
      "import": "./dist/panda.js"
    },
    "./styles.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-css.ts",
    "pack:check": "pnpm build && publint && attw --pack --profile esm-only --exclude-entrypoints ./css ./styles.css",
    "prepare": "pnpm build",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
