{
  "name": "@astilba/ui",
  "version": "0.6.0",
  "private": true,
  "description": "Accessible React components for Astilba products.",
  "homepage": "https://github.com/astilbahq/astilba/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/astilbahq/astilba/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astilbahq/astilba.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible.d.ts",
      "import": "./dist/collapsible.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "import": "./dist/field.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button.d.ts",
      "import": "./dist/icon-button.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./link-button": {
      "types": "./dist/link-button.d.ts",
      "import": "./dist/link-button.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./scroll-area": {
      "types": "./dist/scroll-area.d.ts",
      "import": "./dist/scroll-area.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "import": "./dist/textarea.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "panda codegen && vite build && panda cssgen --splitting && tsx scripts/build-css.ts && tsc -p tsconfig.build.json",
    "pack:check": "pnpm build && publint && attw --pack --profile esm-only --exclude-entrypoints ./styles.css",
    "test": "pnpm build && vitest run",
    "test:watch": "panda codegen && vitest",
    "typecheck": "panda codegen && tsc --noEmit"
  },
  "dependencies": {
    "@astilba/tokens": "workspace:*",
    "@base-ui/react": "1.9.0"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  }
}
