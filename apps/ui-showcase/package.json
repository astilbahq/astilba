{
  "name": "@astilba/showcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/verify-built-showcase.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "dev": "vite",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test",
    "test:browser:install": "playwright install chromium",
    "test:browser:install:ci": "playwright install --with-deps chromium",
    "test:browser:update": "pnpm build && playwright test --update-snapshots",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@astilba/tokens": "workspace:*",
    "@astilba/ui": "workspace:*",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
