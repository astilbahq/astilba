{
  "name": "@astilba/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build && node scripts/verify-built-site.mjs",
    "build:production": "cross-env ASTILBA_SITE=https://astilba.com pnpm build",
    "deploy": "pnpm build:production && wrangler deploy",
    "deploy:dry-run": "pnpm build:production && wrangler deploy --dry-run",
    "dev": "astro dev",
    "lint": "ultracite check",
    "preview": "astro preview",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astilba/tokens": "workspace:*",
    "@astilba/ui": "workspace:*",
    "@astrojs/react": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "astro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "cross-env": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  }
}
