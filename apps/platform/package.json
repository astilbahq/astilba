{
  "name": "@astilba/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vp dev",
    "check": "panda codegen && vp check --deny-warnings",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "check:fix": "panda codegen && vp check --fix",
    "build": "pnpm check && vp build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@xyflow/react": "12.12.0",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@pandacss/dev": "2.3.0",
    "@pandacss/eslint-plugin": "2.3.0",
    "@pandacss/preset-base": "2.3.0",
    "@pandacss/preset-panda": "2.3.0",
    "@pandacss/vite": "2.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsqr": "1.4.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "4.151.3"
  }
