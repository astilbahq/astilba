{
  "name": "@astilba/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vp dev",
    "check": "panda codegen && vp check --deny-warnings && pnpm i18n:check",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "check:fix": "panda codegen && vp check --fix && pnpm i18n:check",
    "i18n:types": "i18next-cli types",
    "i18n:check": "i18next-cli types --ci && i18next-cli lint && i18next-cli status && node scripts/check-catalogues.mjs",
    "build": "pnpm check && vp build",
    "test:browser": "node --test ../../scripts/platform-fixture-test.mjs && playwright test",
    "storybook:prepare": "msw init .storybook/public --no-save",
    "storybook": "pnpm storybook:prepare && storybook dev --host 127.0.0.1 --port 54200 --no-open --disable-telemetry",
    "storybook:build": "pnpm storybook:prepare && storybook build --output-dir ../../.artifacts/storybook/static --disable-telemetry",
    "storybook:test": "pnpm storybook:build && playwright test --config playwright.workshop.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@xyflow/react": "12.12.0",
    "i18next": "26.5.7",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@pandacss/dev": "2.3.0",
    "@pandacss/eslint-plugin": "2.3.0",
    "@pandacss/preset-base": "2.3.0",
    "@pandacss/preset-panda": "2.3.0",
    "@pandacss/vite": "2.3.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/tanstack-react": "10.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "i18next-cli": "1.80.0",
    "jsqr": "1.4.0",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "4.151.3"
  }
}
