---
import { Icon } from "@astrojs/starlight/components";
import { Button } from "@astilba/ui/button";
import { css } from "../../styled-system/css";

const hostClass = css({
  position: "fixed",
  insetBlockStart:
    "calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2)",
  insetInlineEnd: "var(--sl-nav-pad-x)",
  zIndex: "var(--sl-z-index-navbar)",
  display: { base: "block", desktop: "none" },
  inlineSize: "var(--sl-menu-button-size)",
  blockSize: "var(--sl-menu-button-size)",
  _print: {
    display: "none",
  },
});
const buttonClass = css({
  minInlineSize: "var(--sl-menu-button-size)",
  inlineSize: "var(--sl-menu-button-size)",
  blockSize: "var(--sl-menu-button-size)",
});
const iconSwapClass = css({
  position: "relative",
  display: "inline-grid",
  placeItems: "center",
});
const iconClass = css({
  gridArea: "1 / 1",
  display: "inline-grid",
  placeItems: "center",
  transformOrigin: "center",
  transitionProperty: "opacity, filter, transform",
  transitionDuration: "iconSwap",
  transitionTimingFunction: "inOut",
  pointerEvents: "none",
  _reducedMotion: {
    transition: "none",
  },
});
const openIconClass = css({
  opacity: 1,
  filter: "blur(0)",
  transform: "scale(1)",
  "[data-menu-toggle]:has(~ :popover-open) &": {
    opacity: 0,
    filter: "blur(var(--astilba-blurs-icon-swap))",
    transform: "scale(0.25)",
  },
});
const closeIconClass = css({
  opacity: 0,
  filter: "blur(var(--astilba-blurs-icon-swap))",
  transform: "scale(0.25)",
  "[data-menu-toggle]:has(~ :popover-open) &": {
    opacity: 1,
    filter: "blur(0)",
    transform: "scale(1)",
  },
});
---

<!--
  Starlight 0.42 renders the sidebar as a native popover (#starlight__sidebar) right after this
  toggle, and handles opening, Escape, light dismiss and focus trapping itself.
-->
<div data-menu-toggle class:list={[hostClass, "print:hidden"]}>
  <Button
    aria-controls="starlight__sidebar"
    aria-label={Astro.locals.t("menuButton.accessibleLabel")}
    className={buttonClass}
    iconOnly
    popoverTarget="starlight__sidebar"
  >
    <span aria-hidden="true" class={iconSwapClass}>
      <span class:list={[iconClass, openIconClass]}>
        <Icon name="bars" size="1rem" />
      </span>
      <span class:list={[iconClass, closeIconClass]}>
        <Icon name="close" size="1rem" />
      </span>
    </span>
  </Button>
</div>

<script>
  // Mirror the popover's state on the button's aria-expanded attribute. It is not rendered in the
  // HTML: without JavaScript the browser exposes the popover button's expanded state itself, and a
  // static "false" would override it.
  const sidebar = document.querySelector("#starlight__sidebar");
  const button = document.querySelector("[data-menu-toggle] button");

  button?.setAttribute(
    "aria-expanded",
    String(sidebar?.matches(":popover-open") ?? false)
  );
  sidebar?.addEventListener("toggle", (event) => {
    if (event instanceof ToggleEvent) {
      button?.setAttribute("aria-expanded", String(event.newState === "open"));
    }
  });
</script>
