{
  "name": "@astilba/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && astro build && node scripts/generate-agent-skills-index.mjs && node scripts/generate-mcp-corpus.mjs && node scripts/generate-agent-discovery.mjs && node scripts/generate-agent-headers.mjs && node scripts/verify-agent-artifacts.mjs",
    "build:production": "cross-env ASTILBA_DOCS_SITE=https://astilba.com pnpm build",
    "deploy": "pnpm build:production && wrangler deploy",
    "deploy:dry-run": "pnpm build:production && wrangler deploy --dry-run",
    "dev": "astro dev",
    "env:check": "astilba-env generate --check",
    "env:generate": "astilba-env generate",
    "env:release:check": "node scripts/verify-env-release.mjs",
    "knip": "pnpm --dir ../.. exec knip --workspace apps/docs --workspace apps/site",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "panda:codegen": "panda codegen",
    "prepare": "pnpm --filter @astilba/tokens build && pnpm --filter @astilba/ui build && panda codegen",
    "preview": "astro preview",
    "smoke:all": "pnpm smoke:site && pnpm smoke:production",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:site": "pnpm --dir ../site smoke:production",
    "test": "vitest run",
    "test:browser": "pnpm build:production && playwright test",
    "test:browser:install": "playwright install chromium",
    "test:browser:install:ci": "playwright install --with-deps chromium",
    "test:browser:run": "playwright test",
    "test:watch": "vitest",
    "typecheck": "wrangler types --check && astro check",
    "verify": "pnpm env:release:check && pnpm env:check && pnpm panda:codegen && pnpm lint && pnpm --dir ../site lint && pnpm typecheck && pnpm test && pnpm knip && pnpm deploy:dry-run && pnpm test:browser:run && pnpm verify:site",
    "verify:agent-artifacts": "node scripts/verify-agent-artifacts.mjs",
    "verify:site": "pnpm --dir ../site typecheck && pnpm --dir ../site test && pnpm --dir ../site deploy:dry-run && pnpm --dir ../site test:browser",
    "worker:types": "wrangler types"
  },
  "dependencies": {
    "@astilba/env": "0.3.1",
    "@astilba/tokens": "workspace:*",
    "@astilba/ui": "workspace:*",
    "@astrojs/react": "catalog:",
    "@astrojs/starlight": "0.41.11",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@modelcontextprotocol/sdk": "1.32.1",
    "astro": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.25.3",
    "starlight-llms-txt": "0.11.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "catalog:",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@playwright/test": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cross-env": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "parse5": "8.0.1",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
