{
  "name": "@astilba/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && astro build && node scripts/generate-agent-skills-index.mjs && node scripts/generate-mcp-corpus.mjs && node scripts/generate-agent-discovery.mjs && node scripts/generate-agent-headers.mjs && node scripts/verify-agent-artifacts.mjs",
    "build:production": "cross-env ASTILBA_DOCS_SITE=https://astilba.com pnpm build",
    "check": "wrangler types --check && astro check",
    "deploy": "pnpm build:production && wrangler deploy",
    "deploy:dry-run": "pnpm build:production && wrangler deploy --dry-run",
    "dev": "astro dev",
    "env:check": "astilba-env generate --check",
    "env:generate": "astilba-env generate",
    "env:release:check": "node scripts/verify-env-release.mjs",
    "knip": "pnpm --dir ../.. exec knip --workspace apps/docs --workspace apps/site",
    "lint": "ultracite check && pnpm --dir ../site lint",
    "lint:fix": "ultracite fix",
    "panda:codegen": "panda codegen",
    "prepare": "pnpm --filter @astilba/tokens build && pnpm --filter @astilba/ui build && panda codegen",
    "preview": "astro preview",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:all": "pnpm smoke:site && pnpm smoke:production",
    "smoke:site": "pnpm --dir ../site smoke:production",
    "test": "pnpm test:dependency-security && vitest run",
    "test:browser": "pnpm build:production && playwright test",
    "test:browser:install": "playwright install chromium",
    "test:browser:install:ci": "playwright install --with-deps chromium",
    "test:browser:run": "playwright test",
    "test:watch": "vitest",
    "typecheck": "pnpm check",
    "verify": "pnpm env:release:check && pnpm env:check && pnpm panda:codegen && pnpm lint && pnpm check && pnpm test && pnpm knip && pnpm deploy:dry-run && pnpm test:browser:run && pnpm verify:site",
    "verify:site": "pnpm --dir ../site check && pnpm --dir ../site test && pnpm --dir ../site deploy:dry-run && pnpm --dir ../site test:browser",
    "verify:agent-artifacts": "node scripts/verify-agent-artifacts.mjs",
    "worker:types": "wrangler types",
    "test:dependency-security": "node --test scripts/dependency-security.test.mjs"
  },
  "dependencies": {
    "@astilba/env": "0.3.0",
    "@astilba/tokens": "workspace:*",
    "@astilba/ui": "workspace:*",
    "@astrojs/react": "6.0.1",
    "@astrojs/starlight": "0.41.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "astro": "7.2.8",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.25.2",
    "starlight-llms-txt": "0.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.12.1",
    "@pandacss/dev": "1.11.5",
    "@pandacss/preset-base": "1.11.5",
    "@playwright/test": "1.62.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.3",
    "cross-env": "10.1.0",
    "knip": "6.29.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "parse5": "8.0.1",
    "postcss": "8.5.28",
    "typescript": "6.0.3",
    "ultracite": "7.9.4",
    "vitest": "4.1.11",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
