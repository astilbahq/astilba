{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "fixtures/registry/**",
    "products/cache/**/test/integration/*.d.ts",
    "products/cache/apps/demo/worker-configuration.d.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/serve-showcase.mjs!",
        "tooling/migration/*.mjs!",
        "tooling/publishing/*.mjs!"
      ],
      "playwright": {
        "config": [],
        "entry": ["playwright.config.ts!", "tests/e2e/**/*.ts!"]
      }
    },
    "packages/tokens": {
      "entry": ["src/index.ts!", "src/panda.ts!", "tests/**/*.test.ts!"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts!", "tests/**/*.ts!"]
    },
    "packages/ui": {
      "entry": ["src/index.ts!", "tests/**/*.test.tsx!"],
      "ignoreDependencies": ["@astilba/tokens"],
      "project": ["src/**/*.{ts,tsx}!", "tests/**/*.tsx!", "*.config.ts!"]
    },
    "apps/ui-showcase": {
      "entry": ["tests/**/*.test.tsx!"],
      "project": ["src/**/*.{ts,tsx}!", "tests/**/*.tsx!", "*.config.ts!"]
    },
    "fixtures/ui-astro": {
      "entry": ["src/pages/**/*.astro!", "tests/**/*.mjs!"],
      "project": ["src/**/*.astro!", "tests/**/*.mjs!", "*.config.ts!"]
    },
    "packages/env": {
      "entry": [
        "src/index.ts",
        "src/browser/index.ts",
        "src/cli/astilba-env.ts",
        "src/cli/compile.ts",
        "src/runtime/index.ts",
        "src/runtime/workerd.ts",
        "src/vite/index.ts",
        "src/**/*.test.ts",
        "test/**/*.ts",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "publint", "workerd"],
      "ignoreBinaries": ["astilba-env"]
    },
    "apps/docs": {
      "playwright": {
        "config": [],
        "entry": ["playwright.config.ts!", "tests/e2e/**/*.ts!"]
      },
      "entry": [
        "scripts/**/*.mjs!",
        "src/docs/route-middleware.ts!",
        "src/pages/**/*.{astro,ts}!",
        "src/components/{Head,Header,MobileMenuToggle,PageTitle,Sidebar,VersionBanner}.astro!",
        "tests/**/*.test.ts!"
      ],
      "project": [
        "*.config.{cjs,js,mjs,ts}!",
        "scripts/**/*.mjs!",
        "src/**/*.{astro,ts,tsx}!",
        "tests/**/*.ts!",
        "worker/**/*.ts!"
      ],
      "ignoreDependencies": [
        "@fontsource-variable/geist",
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono"
      ]
    },
    "apps/site": {
      "playwright": {
        "config": [],
        "entry": ["playwright.config.ts!", "test/browser/**/*.ts!"]
      },
      "entry": [
        "public/site.js!",
        "scripts/**/*.mjs!",
        "src/pages/**/*.{astro,ts}!",
        "test/**/*.test.ts!",
        "worker/**/*.ts!"
      ],
      "project": [
        "*.config.ts!",
        "scripts/**/*.mjs!",
        "src/**/*.{astro,ts}!",
        "test/**/*.ts!",
        "worker/**/*.ts!"
      ]
    },
    "products/cache": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"],
      "ignoreBinaries": ["react-router"],
      "ignoreDependencies": [
        "eslint-plugin-github",
        "eslint-plugin-sonarjs",
        "miniflare"
      ]
    },
    "products/cache/packages/cache": {
      "entry": [
        "scripts/*.mjs",
        "test/**/*.test.ts",
        "test/integration/worker.ts",
        "test/boot/worker.ts"
      ],
      "project": ["src/**/*.ts!", "test/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["cloudflare"]
    },
    "products/cache/packages/harness": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts!", "!src/fc-setup.ts!"],
      "ignoreDependencies": []
    },
    "products/cache/apps/rr-fixture": {
      "ignoreDependencies": ["@react-router/node"]
    },
    "products/cache/apps/demo": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["@react-router/node", "cloudflare"]
    }
  },
  "tags": ["-testExport"]
}
