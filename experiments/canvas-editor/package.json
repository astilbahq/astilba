{
  "name": "@astilba/canvas-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "panda codegen && vite",
    "check": "panda codegen && tsc --noEmit && biome check src tests *.ts",
    "format": "biome check --write src tests *.ts",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "test:unit": "node --test tests/domain.test.ts",
    "test:browser": "playwright test",
    "verify": "pnpm build && pnpm test:unit && pnpm test:browser"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@xyflow/react": "12.12.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "@pandacss/dev": "2.3.0",
    "@pandacss/vite": "2.3.0",
    "@pandacss/preset-base": "2.3.0",
    "@pandacss/preset-panda": "2.3.0",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2"
  }
}
