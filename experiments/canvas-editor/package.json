{
  "name": "@astilba/canvas-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "panda codegen && vp check --deny-warnings",
    "format": "vp fmt --write .",
    "build": "pnpm check && vp build",
    "preview": "vp preview",
    "test:unit": "node --test tests/domain.test.ts",
    "test:browser": "playwright test",
    "verify": "pnpm build && pnpm test:unit && pnpm test:browser",
    "prepare": "panda codegen",
    "lint": "vp lint --deny-warnings",
    "format:check": "vp fmt --check .",
    "check:fix": "panda codegen && vp check --fix"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@pandacss/vite": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
