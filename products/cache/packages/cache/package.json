{
  "name": "@astilba/cache",
  "version": "0.0.0",
  "private": true,
  "description": "Portable TypeScript caching with tag invalidation, stale-if-error resilience, and privacy scopes.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry/index.ts",
    "./cloudflare": "./src/adapters/cloudflare/index.ts",
    "./react-router": "./src/adapters/react-router/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./cloudflare": {
        "types": "./dist/adapters/cloudflare/index.d.ts",
        "default": "./dist/adapters/cloudflare/index.js"
      },
      "./react-router": {
        "types": "./dist/adapters/react-router/index.d.ts",
        "default": "./dist/adapters/react-router/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "lint:publish": "node scripts/check-package.mjs",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@astilba/harness": "workspace:*",
    "@fast-check/vitest": "^0.4.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/react": "19.2.17",
    "fast-check": "^4.8.0",
    "publint": "0.3.21",
    "react": "19.2.7",
    "react-router": "8.3.0"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-router": "8.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  }
}
