# /etc/astilba/management-backup.env, owned by root with mode 0600.
# See docs/management-backups.md.

# age public keys, one per line. Keep the matching identities off this server.
ASTILBA_BACKUP_RECIPIENTS=/etc/astilba/management-backup.recipients

# Bucket and prefix, path-style, without a trailing slash. Objects are written below it.
ASTILBA_BACKUP_S3_URL=https://s3.example.com/example-bucket/management
# Signing region: "auto" for Cloudflare R2, the bucket's region for Backblaze B2 and AWS.
ASTILBA_BACKUP_S3_REGION=auto
# The access key lives in /etc/astilba/management-backup.s3, which the service unit loads
# as a credential. It is a curl configuration file holding one line:
#   user = "ACCESS_KEY_ID:SECRET_ACCESS_KEY"

# The PostgreSQL container to run pg_dump in. Leave it empty to run pg_dump on this host,
# configured with libpq's environment variables, such as PGHOST and PGPASSFILE.
ASTILBA_BACKUP_DATABASE_CONTAINER=astilba-database-1
ASTILBA_BACKUP_DATABASE_USER=astilba
ASTILBA_BACKUP_DATABASE_NAME=astilba
# Optional: the management container, whose image revision is recorded in the manifest.
ASTILBA_BACKUP_APP_CONTAINER=astilba-platform-1

# A check-in monitor that alerts when no success arrives within a day plus a grace period.
ASTILBA_BACKUP_CHECKIN_URL=https://monitor.example.com/ping/EXAMPLE
# Optional: an address that alerts at once when a run fails.
ASTILBA_BACKUP_FAILURE_URL=https://monitor.example.com/ping/EXAMPLE/fail
