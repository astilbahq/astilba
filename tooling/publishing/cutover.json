{
  "phase": "publishing-disabled",
  "repository": "astilbahq/astilba",
  "runtime": { "node": "24.18.1", "npm": "11.16.0", "pnpm": "11.17.0" },
  "products": {
    "env": {
      "phase": "workflow-installed-disabled",
      "tagPrefix": "env/v",
      "workflow": "release-env.yml",
      "environment": "npm-env",
      "enableVariable": "ENV_PUBLISHER_ENABLED",
      "packages": [{ "name": "@astilba/env", "directory": "packages/env" }]
    },
    "ui": {
      "phase": "retired-workspace-only",
      "tagPrefix": "ui/v",
      "workflow": "release-ui.yml",
      "environment": "npm-ui",
      "packages": [
        { "name": "@astilba/tokens", "directory": "packages/tokens" },
        { "name": "@astilba/ui", "directory": "packages/ui" }
      ]
    }
  }
}
