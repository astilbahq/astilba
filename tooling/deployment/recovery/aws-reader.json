{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::<BACKUP_BUCKET>/<CAPSULE_KEY>",
      "Condition": { "StringEquals": { "s3:VersionId": "<CAPSULE_VERSION>" } }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::<BACKUP_BUCKET>/<RUNTIME_KEY>",
      "Condition": { "StringEquals": { "s3:VersionId": "<RUNTIME_VERSION>" } }
    }
  ]
}
